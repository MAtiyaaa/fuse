-- Artwork for games, platforms, collections and apps. USER rows are never replaced by scrapers.
CREATE TABLE media (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    -- 'game' | 'platform' | 'collection' | 'app'
    owner_type TEXT NOT NULL,
    owner_id TEXT NOT NULL,
    -- MediaKind name
    kind TEXT NOT NULL,
    -- MediaSource name
    source TEXT NOT NULL,
    local_path TEXT,
    remote_url TEXT,
    width INTEGER,
    height INTEGER,
    focus_x REAL NOT NULL DEFAULT 0.5,
    focus_y REAL NOT NULL DEFAULT 0.5,
    zoom REAL NOT NULL DEFAULT 1.0,
    sort_order INTEGER NOT NULL DEFAULT 0,
    added_at INTEGER NOT NULL
);

CREATE INDEX media_owner ON media(owner_type, owner_id, kind);

-- 0.4.2.12 (Fuseline 4.2): which owners' art changed, in order, written by the database itself on
-- every change to media, whoever makes it. A list of games re-reads only the art that changed
-- instead of every game's on every change. Old entries are pruned (see MediaRepository).
CREATE TABLE media_change (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    owner_type TEXT NOT NULL,
    owner_id TEXT NOT NULL
);

CREATE TRIGGER media_change_insert AFTER INSERT ON media BEGIN
    INSERT INTO media_change(owner_type, owner_id) VALUES (new.owner_type, new.owner_id);
END;

CREATE TRIGGER media_change_update AFTER UPDATE ON media BEGIN
    INSERT INTO media_change(owner_type, owner_id) VALUES (new.owner_type, new.owner_id);
    INSERT INTO media_change(owner_type, owner_id) SELECT old.owner_type, old.owner_id WHERE old.owner_type <> new.owner_type OR old.owner_id <> new.owner_id;
END;

CREATE TRIGGER media_change_delete AFTER DELETE ON media BEGIN
    INSERT INTO media_change(owner_type, owner_id) VALUES (old.owner_type, old.owner_id);
END;

-- Fires for every change to media (SQLDelight tells listeners of the media table): a cheap tick.
mediaTick:
SELECT 0 FROM media LIMIT 1;

lastChange:
SELECT COALESCE(MAX(seq), 0) FROM media_change;

firstChange:
SELECT COALESCE(MIN(seq), 0) FROM media_change;

changesSince:
SELECT seq, owner_type, owner_id FROM media_change WHERE seq > ? ORDER BY seq;

pruneChanges:
DELETE FROM media_change WHERE seq <= ?;

-- USER rows first within a kind, so they win when the UI picks one.
selectByOwner:
SELECT * FROM media WHERE owner_type = ? AND owner_id = ?
ORDER BY kind, CASE WHEN source = 'USER' THEN 0 ELSE 1 END, sort_order, id;

selectByOwners:
SELECT * FROM media WHERE owner_type = ? AND owner_id IN ?
ORDER BY owner_id, kind, CASE WHEN source = 'USER' THEN 0 ELSE 1 END, sort_order, id;

-- What a list of games reads of each one's art: only what its pictures need, in each owner's order.
artByOwners:
SELECT owner_id, kind, source, local_path, remote_url, width, height, focus_x, focus_y, zoom FROM media
WHERE owner_type = ? AND owner_id IN ?
ORDER BY owner_id, kind, CASE WHEN source = 'USER' THEN 0 ELSE 1 END, sort_order, id;

selectKind:
SELECT * FROM media WHERE owner_type = ? AND owner_id = ? AND kind = ?
ORDER BY CASE WHEN source = 'USER' THEN 0 ELSE 1 END, sort_order, id;

countKind:
SELECT COUNT(*) FROM media WHERE owner_type = ? AND owner_id = ? AND kind = ?;

insert:
INSERT INTO media(owner_type, owner_id, kind, source, local_path, remote_url, width, height,
    focus_x, focus_y, zoom, sort_order, added_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteKindUser:
DELETE FROM media WHERE owner_type = ? AND owner_id = ? AND kind = ? AND source = 'USER';

deleteKindNonUser:
DELETE FROM media WHERE owner_type = ? AND owner_id = ? AND kind = ? AND source <> 'USER';

deleteKind:
DELETE FROM media WHERE owner_type = ? AND owner_id = ? AND kind = ?;

deleteSource:
DELETE FROM media WHERE owner_type = ? AND owner_id = ? AND source = ? AND source <> 'USER';

deleteNonUser:
DELETE FROM media WHERE owner_type = ? AND owner_id = ? AND source <> 'USER';

deleteOwner:
DELETE FROM media WHERE owner_type = ? AND owner_id = ?;

updateLocalFolderPath:
UPDATE media SET local_path = :localPath
WHERE owner_type = :ownerType AND owner_id = :ownerId AND kind = :kind AND source = 'LOCAL_FOLDER';

adjust:
UPDATE media SET focus_x = :focusX, focus_y = :focusY, zoom = :zoom WHERE id = :id;

-- Visible (present, not removed) games with no media of :kind, optionally for one platform.
gamesLackingKind:
SELECT g.id FROM game g
WHERE +g.missing = 0 AND g.removed_at IS NULL
    AND (:platformId IS NULL OR g.platform_id = :platformId)
    AND NOT EXISTS (
        SELECT 1 FROM media m
        WHERE m.owner_type = 'game' AND m.owner_id = CAST(g.id AS TEXT) AND m.kind = :kind
    )
ORDER BY g.id;

-- Art found next to the games (LOCAL_FOLDER) follows its library folder when the drive moves.
relinkLocalMedia:
UPDATE media SET local_path = CASE WHEN local_path = :old THEN :new ELSE :new || substr(local_path, length(:old) + 1) END
WHERE source = 'LOCAL_FOLDER' AND substr(local_path, 1, length(:old) + 1) = :old || '/';
