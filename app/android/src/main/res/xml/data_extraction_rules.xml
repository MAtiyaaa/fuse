<?xml version="1.0" encoding="utf-8"?>
<!--
  No cloud backup of Fuse's data. A device-to-device transfer may carry the library and settings,
  but never the credentials file: its key lives in the old device's Keystore and cannot move.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fuse_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
