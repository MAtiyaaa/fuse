-- Observed play sessions. An open session has ended_at NULL; its duration is never invented.
CREATE TABLE play_session (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    game_id INTEGER NOT NULL REFERENCES game(id) ON DELETE CASCADE,
    emulator_id TEXT,
    started_at INTEGER NOT NULL,
    ended_at INTEGER,
    -- PlaySessionSource name
    source TEXT NOT NULL
);

CREATE INDEX play_session_game ON play_session(game_id, started_at);
CREATE INDEX play_session_ended ON play_session(ended_at);

insert:
INSERT INTO play_session(game_id, emulator_id, started_at, ended_at, source) VALUES (?, ?, ?, ?, ?);

selectById:
SELECT * FROM play_session WHERE id = ?;

countAt:
SELECT COUNT(*) FROM play_session WHERE game_id = ? AND started_at = ?;

selectOpen:
SELECT * FROM play_session WHERE ended_at IS NULL ORDER BY started_at DESC, id DESC LIMIT 1;

deleteOpen:
DELETE FROM play_session WHERE ended_at IS NULL;

deleteById:
DELETE FROM play_session WHERE id = ?;

setEnded:
UPDATE play_session SET ended_at = :endedAt WHERE id = :id AND ended_at IS NULL;

endedAfter:
SELECT started_at, ended_at FROM play_session WHERE ended_at IS NOT NULL AND ended_at > :since;

byGame:
SELECT * FROM play_session WHERE game_id = ? ORDER BY started_at DESC, id DESC;

-- Sessions that ended after :since, with their game (play time pages).
endedAfterWithGame:
SELECT game_id, started_at, ended_at FROM play_session WHERE ended_at IS NOT NULL AND ended_at > :since;

-- Sessions that ran at some point in [:from, :until), with their game's system (Your Year).
inWindow:
SELECT s.game_id, g.platform_id, s.started_at, s.ended_at FROM play_session s JOIN game g ON g.id = s.game_id
WHERE s.ended_at IS NOT NULL AND s.ended_at > :from AND s.started_at < :until;

-- When each game was first seen played here: its first session's start.
firstPlayed:
SELECT game_id, MIN(started_at) AS first FROM play_session WHERE ended_at IS NOT NULL GROUP BY game_id;

-- The first and last moment anything was played here, for which recaps there are.
playedSpan:
SELECT MIN(started_at) AS first, MAX(ended_at) AS last FROM play_session WHERE ended_at IS NOT NULL;

-- All play time per system: what Fuse saw plus what was imported.
secondsByPlatform:
SELECT platform_id, SUM(tracked_seconds + imported_seconds) AS seconds FROM game
WHERE removed_at IS NULL AND tracked_seconds + imported_seconds > 0
GROUP BY platform_id ORDER BY seconds DESC;

-- Sessions describe actual observed play and now refer to the proven title rather than its package.
reassignAbsorbed:
UPDATE play_session SET game_id = :ownerId WHERE game_id = :childId;

-- Each emulator's latest game seen running through Fuse on this device for at least :minMs, and how
-- many such sessions there were (what "Launch verified" rests on). Sessions from other devices or
-- imported time never count.
playedByEmulator:
SELECT emulator_id, MAX(ended_at) AS lastEnded, COUNT(*) AS sessions FROM play_session
WHERE emulator_id IS NOT NULL AND ended_at IS NOT NULL AND ended_at - started_at >= :minMs
AND source IN ('FUSE_LAUNCH', 'USAGE_STATS')
GROUP BY emulator_id;
