    <path
        android:name="spark"
        android:fillColor="@color/fuse_spark"
        android:pathData="M65.2,42.8 m-3.92,0 a3.92,3.92 0 1 0 7.84,0 a3.92,3.92 0 1 0 -7.84,0" />
