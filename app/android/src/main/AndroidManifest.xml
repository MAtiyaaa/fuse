    <application
        android:name=".FuseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Fuse"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fuse"
        tools:ignore="DataExtractionRules"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|grammaticalGender|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Fuse's Home: hands over to MainActivity in its own normal task, so Fuse shows in recent apps
          (Android never lists the Home task there). Never drawn. Reached only through HomeAlias.
        -->
        <activity
            android:name=".HomeActivity"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|grammaticalGender|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity="io.github.matiyaaa.fuse.home"
            android:theme="@style/Theme.Fuse.Trampoline" />

        <!-- Makes Fuse a Home app. Disabled until the user asks (see AndroidHomeRole). -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Second screen. Started by Fuse only, in its own task on the other display. -->
        <activity
            android:name=".CompanionActivity"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|grammaticalGender|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:taskAffinity="io.github.matiyaaa.fuse.companion" />

        <!--
          The companion as Home of secondary displays. Android only starts it while Fuse is the Home
          app (it looks for SECONDARY_HOME in the Home app's package). Exported because the system
          starts it; it only shows the companion screen. Not single-instance: Android refuses those
          as a secondary Home.
        -->
        <activity
            android:name=".CompanionHomeActivity"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|grammaticalGender|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:taskAffinity="io.github.matiyaaa.fuse.companion.home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <!-- Fuse was just updated: it opens itself again (see UpdateRelaunch). The system sends it. -->
        <receiver
            android:name=".services.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".services.InstallResultReceiver"
            android:exported="false" />

        <!-- Runs only while Fuse records its screen (see CaptureService). -->
        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Read-only play sessions for Cartridge (see PlayShareProvider and READ_PLAY above). -->
        <provider
            android:name=".services.PlayShareProvider"
            android:authorities="${applicationId}.play"
            android:exported="true"
            android:grantUriPermissions="true"
            android:readPermission="io.github.matiyaaa.fuse.permission.READ_PLAY" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Only used for benchmark tooling over adb; Fuse exports nothing besides its launcher and Home entries. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
