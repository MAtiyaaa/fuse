<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Finding Jellyfin servers on the network: their replies to a broadcast. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Libraries are read by path, and FileProvider launches need Fuse to own file access (ES-DE does the same). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Installing Cartridge and Fuse updates, always through the system's confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The Store's Uninstall: Android still asks the user to confirm every removal. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Screen brightness from the second screen's controls, only once the user allows it in Android's settings. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!--
      Screen recordings of Fuse's own screen (Settings, Inputs): the foreground service Android
      requires while recording, its notification with a Stop button, and Fuse's own sound through
      Android's playback capture, which asks for the microphone permission but records no microphone.
      Android 9 saves captures as plain files in Pictures and Movies, which needs the storage permission.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Cartridge's read-only status provider. -->
    <uses-permission android:name="io.github.abdu2304.cartridge.permission.READ_STATUS" />

    <!--
      Fuse's play sessions for Cartridge (PlayShareProvider), so Cartridge's Start screen counts games played
      from Fuse. Normal: any app that asks gets it; Fuse also grants Cartridge access itself at start.
    -->
    <permission
        android:name="io.github.matiyaaa.fuse.permission.READ_PLAY"
        android:label="@string/play_permission_label"
        android:description="@string/play_permission_description"
        android:protectionLevel="normal" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

