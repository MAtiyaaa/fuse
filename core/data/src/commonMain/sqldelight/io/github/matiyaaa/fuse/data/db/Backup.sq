-- Reads and writes for Fuse backups (0.2.0). Queries only; no tables of their own.

gamesForBackup:
SELECT g.id, g.platform_id, g.platform_scanned, g.path, s.path AS source_path, g.title_custom, g.title_metadata,
    g.use_cleaned, g.metadata_json, g.release_year, g.favorite, g.hidden, g.pinned, g.removed_at, g.emulator_override,
    g.platform_override, g.folder_policy_override, g.tracked_seconds, g.imported_seconds, g.imported_source,
    g.session_count, g.last_played_at, g.ra_game_id, g.sgdb_game_id, g.igdb_id, g.romm_rom_id, g.steam_app_id
FROM game g LEFT JOIN library_source s ON s.id = g.source_id;

endedSessions:
SELECT game_id, emulator_id, started_at, ended_at, source FROM play_session WHERE ended_at IS NOT NULL;

manualCollections:
SELECT id, name, sort_order, created_at FROM game_collection WHERE kind = 'MANUAL' ORDER BY sort_order, id;

collectionMembers:
SELECT collection_id, game_id, sort_order FROM collection_game ORDER BY collection_id, sort_order;

userMedia:
SELECT owner_type, owner_id, kind, local_path, remote_url, width, height, focus_x, focus_y, zoom
FROM media WHERE source = 'USER';

scopedRows:
SELECT scope, scope_id, key, value_json FROM setting WHERE scope <> 'GLOBAL' OR scope_id <> '' OR key <> 'app';

sessionExists:
SELECT COUNT(*) FROM play_session WHERE game_id = :gameId AND started_at = :startedAt;

manualCollectionByName:
SELECT id FROM game_collection WHERE kind = 'MANUAL' AND name = :name LIMIT 1;

userMediaKindCount:
SELECT COUNT(*) FROM media WHERE owner_type = :ownerType AND owner_id = :ownerId AND kind = :kind AND source = 'USER';

-- A restored game's own choices. Values are merged in Kotlin, so nothing set here is lost.
restoreGame:
UPDATE game SET favorite = :favorite, hidden = :hidden,
    pinned = :pinned, removed_at = :removedAt, emulator_override = :emulatorOverride,
    platform_override = :platformOverride, platform_id = COALESCE(:platformOverride, platform_scanned, platform_id),
    folder_policy_override = :folderPolicy, tracked_seconds = :tracked, imported_seconds = :imported,
    imported_source = :importedSource, session_count = :sessions, last_played_at = :lastPlayed,
    ra_game_id = :raGameId, sgdb_game_id = :sgdbGameId, igdb_id = :igdbId, romm_rom_id = :rommRomId,
    steam_app_id = :steamAppId, updated_at = :now
WHERE id = :id;
