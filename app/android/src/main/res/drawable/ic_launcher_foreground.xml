    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:name="frame"
        android:fillColor="#00000000"
        android:pathData="M44.48,28.8 H63.52 A15.68,15.68 0 0 1 79.2,44.48 V63.52 A15.68,15.68 0 0 1 63.52,79.2 H44.48 A15.68,15.68 0 0 1 28.8,63.52 V44.48 A15.68,15.68 0 0 1 44.48,28.8 Z"
        android:strokeWidth="5.6"
        android:strokeColor="@color/fuse_mark" />

    <path
